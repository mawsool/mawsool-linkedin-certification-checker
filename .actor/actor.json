{
  "$schema": "https://apify.com/schemas/v1/actor.ide.json",
  "actorSpecification": 1,
  "name": "mawsool-linkedin-certification-checker",
  "title": "LinkedIn Certification Checker",
  "description": "Check whether LinkedIn profiles have a required certification. Yes or no, one charge per profile, $1 per 1,000.",
  "seoTitle": "LinkedIn Certification Checker",
  "seoDescription": "Yes or no: does this LinkedIn profile have the certification you need? $1 per 1,000 profiles.",
  "categories": [
    "LEAD_GENERATION",
    "SOCIAL_MEDIA"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "minMemoryMbytes": 256,
  "maxMemoryMbytes": 1024,
  "defaultRunOptions": {
    "build": "latest",
    "timeoutSecs": 21600,
    "memoryMbytes": 256
  },
  "environmentVariables": {
    "CHARGE_EVENT": "profile-certification-check",
    "GUEST_API_KEY": "@mawsoolGuestApiKey"
  },
  "meta": {
    "templateId": "ts-empty",
    "generatedBy": "Cursor Agent"
  },
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "storages": {
    "dataset": "./dataset_schema.json"
  },
  "pricing": "./pay_per_event.json",
  "dockerfile": "../Dockerfile"
}
